# Example environment for the third-party AS. Copy to .env and adjust; .env is never
# committed (AGENT.md section 9).
#
# Every knob below is declared in AGENT.md section 8 and parsed by
# src/as_app/bootstrap.py (pydantic-settings). Switching from the local mock to a real
# S-SBC is a change of SBC_PEER_* and ALLOWED_PEERS only.

# ----------------------------------------------------------------- SIP trunk
# Where the AS receives the trunk from the operator's S-SBC.
SIP_LISTEN_ADDRESS=127.0.0.1
SIP_LISTEN_PORT=5060

# Next hop for the INVITE the AS originates back to the trunk.
# With the local mock this is the mock's UAS port (docker: s-sbc-mock:15061).
SBC_PEER_ADDRESS=127.0.0.1
SBC_PEER_PORT=15061

# Source addresses accepted on the trunk, comma separated. Anything else is rejected
# with 403 and AS-PEER-001. This is the only peer check the POC performs.
ALLOWED_PEERS=127.0.0.1

# ----------------------------------------------------------------- Routing
# Declarative routing rules; reloaded when the file changes (ADR-0004).
RULES_FILE=config/routing_rules.yaml

# ------------------------------------------------------------- Internal API
# How the console reaches the AS (separate process, ADR-0002).
INTERNAL_API_ADDRESS=127.0.0.1
INTERNAL_API_PORT=8080

# -------------------------------------------------------------- Observability
# One of CRITICAL, ERROR, WARNING, INFO, DEBUG.
LOG_LEVEL=INFO
# Emit JSON log lines (true) or a human readable single line (false).
LOG_STRUCTURED=true
# Log SIP payloads. Off by default: payload display is a console feature
# (AGENT.md section 9).
LOG_PAYLOADS=false

# ------------------------------------------------------------------ Runtime
# Time allowed for in-flight calls to finish on SIGTERM/SIGINT.
SHUTDOWN_GRACE_SECONDS=5
